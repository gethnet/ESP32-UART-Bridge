{
  "description": "Alpine.js libraries for ESP32 UART Bridge Web UI",
  "updated": "2026-07-24",
  "libraries": {
    "alpine": {
      "version": "3.15.12",
      "file": "alpine.min.js",
      "url": "https://cdn.jsdelivr.net/npm/alpinejs@3.15.12/dist/cdn.min.js",
      "docs": "https://alpinejs.dev/start-here"
    },
    "alpine-persist": {
      "version": "3.15.12",
      "file": "alpine-persist.min.js",
      "url": "https://cdn.jsdelivr.net/npm/@alpinejs/persist@3.15.12/dist/cdn.min.js",
      "docs": "https://alpinejs.dev/plugins/persist"
    },
    "alpine-collapse": {
      "version": "3.15.12",
      "file": "alpine-collapse.min.js",
      "url": "https://cdn.jsdelivr.net/npm/@alpinejs/collapse@3.15.12/dist/cdn.min.js",
      "docs": "https://alpinejs.dev/plugins/collapse"
    },
    "xterm": {
      "version": "6.1.0-beta.291",
      "files": ["xterm.js", "xterm.css"],
      "url_js": "https://cdn.jsdelivr.net/npm/@xterm/xterm@6.1.0-beta.291/lib/xterm.js",
      "url_css": "https://cdn.jsdelivr.net/npm/@xterm/xterm@6.1.0-beta.291/css/xterm.css",
      "docs": "https://xtermjs.org/",
      "notes": "Loaded dynamically when ANSI mode enabled. Pinned to a beta build (npm dist-tag @beta = master head auto-publish) because 6.0.1 was never tagged despite 250+ commits after 6.0.0 (Dec 2025). Beta.291 carries WriteBuffer dispose-timer fix critical for our dispose/reinit-on-ANSI-toggle pattern"
    },
    "xterm-addon-fit": {
      "version": "0.12.0-beta.291",
      "files": ["xterm-addon-fit.js"],
      "url_js": "https://cdn.jsdelivr.net/npm/@xterm/addon-fit@0.12.0-beta.291/lib/addon-fit.js",
      "notes": "Auto-resize xterm to container dimensions. Beta build matched to xterm core (same build number 291)"
    }
  },
  "loadOrder": [
    "alpine-persist.min.js",
    "alpine-collapse.min.js",
    "alpine.min.js"
  ],
  "notes": "Plugins must be loaded BEFORE alpine.min.js. xterm.js loaded on demand."
}
